EXPO_PUBLIC_PRIMARY_API_URL= 'https://api.met.no/weatherapi/locationforecast/2.0'
EXPO_PUBLIC_FALLBACK_API_URL= 'https://api.met.no/weatherapi/locationforecast/2.0'
EXPO_PUBLIC_APP_USER_AGENT= 'Climweb - Weather App v1'
EXPO_PUBLIC_APP_TIMEZONE = 'Africa/Addis_Ababa'

# Language on a fresh install: the "code" of a language file in
# lib/localization/translations (default en). Users can still change it on
# the Welcome screen or in Settings. CAP alert feeds are set per language in
# those files (cap_feed_url, fallback_cap_feed_url, cap_sender_id).
EXPO_PUBLIC_DEFAULT_LANGUAGE = 'sw'
EXPO_PUBLIC_FORECAST_PROVIDER = 'yr'
EXPO_PUBLIC_ALERTS_PROVIDER = 'cap'
# More tab plugins (plugins/<name>) shown after Favourites, in this order.
# Unset shows Favourites alone — see docs/CONFIGURATION.md, More Tab Plugins.
EXPO_PUBLIC_MORE_PLUGINS = 'at-sea,farming'
# Shared by the plugins: sun times service and the met service's short name.
EXPO_PUBLIC_SUNRISE_API_URL = 'https://api.met.no/weatherapi/sunrise/3.0'
EXPO_PUBLIC_NAME_OF_THE_NHMS = 'TMA'
# at-sea plugin (all optional; TMA defaults shown) — see docs/CONFIGURATION.md, At Sea Page.
EXPO_PUBLIC_AT_SEA_WARNING_KEYWORDS = 'wind,gale,marine,sea,wave,swell,cyclone,tropical storm,storm surge,tsunami,coastal,upepo,bahari,mawimbi,kimbunga'
EXPO_PUBLIC_MARINE_FORECAST_URL = 'https://www.meteo.go.tz/services/marine-weather-forecast'
EXPO_PUBLIC_TSUNAMI_CENTRE_URL = 'https://www.meteo.go.tz/services/tsunami-centre'
# farming plugin (all optional; TMA defaults shown) — see docs/CONFIGURATION.md,
# For Farming Page. Soil thresholds are placeholders for the agromet team.
EXPO_PUBLIC_SOIL_PROVIDER = 'open-meteo'
EXPO_PUBLIC_OPEN_METEO_API_URL = 'https://api.open-meteo.com/v1/forecast'
# Commercial plan only.
EXPO_PUBLIC_OPEN_METEO_API_KEY = ''
EXPO_PUBLIC_OPEN_METEO_SOIL_TEMPERATURE_VAR = 'soil_temperature_6cm'
EXPO_PUBLIC_OPEN_METEO_SOIL_MOISTURE_VAR = 'soil_moisture_3_to_9cm'
EXPO_PUBLIC_SOIL_MOISTURE_DRY_BELOW = '0.15'
EXPO_PUBLIC_SOIL_MOISTURE_TOO_WET_FROM = '0.35'
EXPO_PUBLIC_SOIL_TEMPERATURE_COLD_BELOW = '12'
EXPO_PUBLIC_SOIL_TEMPERATURE_COOL_BELOW = '20'
EXPO_PUBLIC_SOIL_TEMPERATURE_HOT_FROM = '40'
EXPO_PUBLIC_SEASONAL_FORECAST_URL = 'https://www.meteo.go.tz/publications/seasonal-weather-forecast'
EXPO_PUBLIC_AGROMET_BULLETINS_URL = 'https://www.meteo.go.tz/publications/agrometeorological-bulletins'
EXPO_PUBLIC_APP_COUNTRY_BBOX = '33.0,3.4,47.98,14.89'

# XYZ raster tile URL for the alert detail mini-map. The default below is
# OpenStreetMap's public tile server (fine for development only — see
# https://operations.osmfoundation.org/policies/tiles/). Point this at your
# own deployment's OSM tile server for production.
EXPO_PUBLIC_OSM_TILE_URL = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png'

# In-app review prompt (all optional; defaults shown). For local testing set
# the thresholds to 0 and EXPO_PUBLIC_REVIEW_DEBUG=true (development builds
# only) — see docs/CONFIGURATION.md, In-app Review Prompt.
EXPO_PUBLIC_REVIEW_MIN_DAYS_USED = '5'
EXPO_PUBLIC_REVIEW_MIN_DAYS_SINCE_INSTALL = '7'
EXPO_PUBLIC_REVIEW_MIN_DAYS_BETWEEN_PROMPTS = '90'
EXPO_PUBLIC_REVIEW_MAX_PROMPTS = '3'
EXPO_PUBLIC_REVIEW_DEBUG = 'false'

# Default display units for a fresh install; users can change them in
# Settings > Units. Optional — unset or invalid values fall back to these.
#   temperature: celsius | fahrenheit
#   wind:        kmh | ms | knots | mph
#   rain:        mm | in
EXPO_PUBLIC_DEFAULT_TEMPERATURE_UNIT = 'celsius'
EXPO_PUBLIC_DEFAULT_WIND_UNIT = 'kmh'
EXPO_PUBLIC_DEFAULT_PRECIPITATION_UNIT = 'mm'
