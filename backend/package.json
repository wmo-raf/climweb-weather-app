{
  "name": "climweb-alerts-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Location-based push delivery for Climweb CAP weather alerts",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down"
  },
  "dependencies": {
    "@elastic/ecs-pino-format": "^1.5.0",
    "@turf/turf": "^7.3.5",
    "axios": "^1.18.1",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.9.0",
    "graphile-worker": "^0.17.3",
    "luxon": "^3.7.2",
    "node-cron": "^4.5.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
