# HTTP server
PORT=3000

# postgres://user:password@host:port/database — must point at a PostGIS-enabled database
DATABASE_URL=postgres://climweb:climweb@localhost:5432/climweb_alerts

# CAP RSS feed polled by the scheduler as a fallback to the webhook (see EXPO_PUBLIC_PRIMARY_ALERTS_URL in the app's own .env.example)
CAP_FEED_URL=https://severeweather.wmo.int/v2/cap-alerts/et-emi-en/rss.xml

# Must match the client's EXPO_PUBLIC_APP_ALERTS_SENDER_ID — alerts from any other sender are ignored
CAP_ALERTS_SENDER_ID=emi@ethiomet.gov.et

APP_USER_AGENT=climweb-alerts-backend

# Minutes; POLL_INTERVAL_MINUTES/RECEIPT_CHECK_INTERVAL_MINUTES must divide 60 evenly (cron steps on the minute field)
POLL_INTERVAL_MINUTES=5
RECEIPT_CHECK_INTERVAL_MINUTES=30

# Minutes; must be a positive multiple of 60 (cron steps on the hour field)
REMINDER_INTERVAL_MINUTES=180

# Expo access token, only required if this project has enhanced push security enabled
EXPO_ACCESS_TOKEN=

# Shared secret the CAP alert composer must send in the X-Webhook-Secret header
WEBHOOK_SECRET=change-me

LOG_DIR=./logs
